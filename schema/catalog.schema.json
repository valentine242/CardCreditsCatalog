{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valentine242.github.io/CardCreditsCatalog/schema/catalog.schema.json",
  "title": "Card Credits catalog",
  "type": "object",
  "required": ["schema_version", "generated", "cards"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated": { "$ref": "#/$defs/date" },
    "note": { "type": "string" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "card": {
      "type": "object",
      "required": ["id", "name", "issuer", "benefits"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "benefits": { "type": "array", "items": { "$ref": "#/$defs/benefit" } }
      }
    },
    "benefit": {
      "type": "object",
      "required": [
        "id", "name", "category", "value_text", "value_usd", "period",
        "setup_step", "details", "source_url", "last_verified", "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "Dining", "Food delivery", "Rideshare", "Hotels", "Airlines & flights",
            "Travel", "Streaming & entertainment", "Shopping & memberships",
            "Fitness & wellness"
          ]
        },
        "value_text": { "type": "string" },
        "value_usd": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "period": {
          "enum": ["Monthly", "Quarterly", "Twice a year", "Annual", "Anniversary", "One time"]
        },
        "setup_step": { "type": ["string", "null"] },
        "details": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"], "pattern": "^https://" },
        "last_verified": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "status": { "enum": ["needs_review", "verified", "removed"] },
        "end_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": {
            "properties": {
              "source_url": { "type": "string" },
              "last_verified": { "type": "string" }
            }
          }
        },
        {
          "if": { "required": ["end_date"], "properties": { "end_date": { "type": "string" } } },
          "then": { "properties": { "period": { "const": "One time" } } }
        }
      ]
    }
  }
}
